generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  privyId       String?  @unique @db.VarChar(100)
  walletAddress String?  @unique @db.VarChar(42)
  username      String?  @unique @db.VarChar(30)
  displayName   String?  @db.VarChar(100)
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts        Post[]
  votes        Vote[]
  donations    Donation[]
  transactions Transaction[]

  @@index([walletAddress])
  @@index([privyId])
}

model Campaign {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(200)
  description     String?  @db.Text
  category        String?  @db.VarChar(50)
  rules           Json?
  maxPostsPerUser Int      @default(3)
  status          CampaignStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts        Post[]
  donations    Donation[]
  transactions Transaction[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model Post {
  id            String   @id @default(uuid())
  campaignId    String
  userId        String
  imageUrl      String
  caption       String?  @db.VarChar(500)
  voteCount     Int      @default(0)
  donationCount Int      @default(0)
  donationAmount Decimal  @default(0) @db.Decimal(20, 8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     Vote[]
  donations Donation[]

  @@unique([campaignId, userId, id])
  @@index([campaignId])
  @@index([userId])
  @@index([voteCount])
  @@index([donationAmount])
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Donation {
  id              String        @id @default(uuid())
  campaignId      String
  postId          String
  userId          String
  amount          Decimal       @db.Decimal(20, 8)
  token           String        @default("USDC") @db.VarChar(10)
  status          DonationStatus @default(PENDING)
  txHash          String?       @unique @db.VarChar(66)
  blockNumber     BigInt?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([postId])
  @@index([userId])
  @@index([txHash])
  @@index([status])
}

model Transaction {
  id          String            @id @default(uuid())
  txHash      String            @unique @db.VarChar(66)
  chainId     Int
  userId      String?
  campaignId  String?
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal?          @db.Decimal(20, 8)
  token       String?           @db.VarChar(10)
  blockNumber BigInt?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([txHash])
  @@index([userId])
  @@index([campaignId])
  @@index([type])
  @@index([status])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum TransactionType {
  DONATION
  CAMPAIGN_CREATION
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}
