generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @db.VarChar(42)
  username      String?  @unique @db.VarChar(30)
  displayName   String?  @db.VarChar(100)
  avatarUrl     String?
  nonce         String   @default(uuid()) @db.VarChar(64)
  nonceExpiresAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts        Post[]
  votes        Vote[]
  backings     Backing[]
  rewards      Reward[]
  transactions Transaction[]

  @@index([walletAddress])
}

model Campaign {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(200)
  description     String?  @db.Text
  category        String?  @db.VarChar(50)
  rules           Json?
  maxPostsPerUser Int      @default(3)
  status          CampaignStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  aiGenerationId  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts    Post[]
  backings Backing[]
  results  CampaignResult[]
  rewards  Reward[]
  transactions Transaction[]
  aiGeneration AICampaignGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model Post {
  id            String   @id @default(uuid())
  campaignId    String
  userId        String
  imageUrl      String
  caption       String?  @db.VarChar(500)
  voteCount     Int      @default(0)
  backerCount   Int      @default(0)
  backingAmount Decimal  @default(0) @db.Decimal(20, 8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    Vote[]
  backings Backing[]

  @@unique([campaignId, userId, id])
  @@index([campaignId])
  @@index([userId])
  @@index([voteCount])
  @@index([backingAmount])
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Backing {
  id              String        @id @default(uuid())
  campaignId      String
  postId          String
  userId          String
  amount          Decimal       @db.Decimal(20, 8)
  token           String        @default("USDC") @db.VarChar(10)
  status          BackingStatus @default(PENDING)
  txHash          String?       @unique @db.VarChar(66)
  blockNumber     BigInt?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([postId])
  @@index([userId])
  @@index([txHash])
  @@index([status])
}

model CampaignResult {
  id          String   @id @default(uuid())
  campaignId  String
  postId      String
  rank        Int
  voteCount   Int      @default(0)
  backerCount Int      @default(0)
  backingAmount Decimal @default(0) @db.Decimal(20, 8)
  viralityScore Decimal @default(0) @db.Decimal(10, 4)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, postId])
  @@index([campaignId])
  @@index([rank])
}

model Reward {
  id         String     @id @default(uuid())
  campaignId String
  userId     String
  postId     String?
  type       RewardType
  amount     Decimal    @db.Decimal(20, 8)
  token      String     @default("USDC") @db.VarChar(10)
  multiplier Decimal?   @db.Decimal(10, 4)
  status     RewardStatus @default(PENDING)
  txHash     String?    @unique @db.VarChar(66)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
  @@index([type])
  @@index([status])
}

model Transaction {
  id          String            @id @default(uuid())
  txHash      String            @unique @db.VarChar(66)
  chainId     Int
  userId      String?
  campaignId  String?
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal?          @db.Decimal(20, 8)
  token       String?           @db.VarChar(10)
  blockNumber BigInt?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([txHash])
  @@index([userId])
  @@index([campaignId])
  @@index([type])
  @@index([status])
}

model AICampaignGeneration {
  id            String   @id @default(uuid())
  prompt        String
  trendContext  Json?
  model         String
  generatedData Json
  createdAt     DateTime @default(now())

  campaign Campaign?

  @@index([createdAt])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum BackingStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum RewardType {
  CREATOR_REWARD
  BACKER_REWARD
}

enum RewardStatus {
  PENDING
  DISTRIBUTED
  FAILED
}

enum TransactionType {
  BACKING
  REWARD
  CAMPAIGN_CREATION
  SETTLEMENT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}
